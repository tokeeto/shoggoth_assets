                "weakness_label": "%:WEAKNESS"
            }
        },
        {
            "when": "encounter",
            "set": {
                "template": "chapter_1/event_neutral",
                "level_overlay": "neutral_no_level.png",
                "encounter_overlay": "story_event_overlay.png",
                "collection": "<esn>/<est>",
                "collection_region": {"x": 935,"y": 2099,"width": 350,"height": 40}
            }
        },
        {
            "when": ["basic weakness"],
            "set": {
                "weakness_label": "%:BASIC WEAKNESS",
                "encounter_overlay": "basic_weakness_event.png",
                "encounter_icon": "basic_weakness_icon.png"
            }
        },
        {
            "when": "multi",
            "set": { "template": "chapter_1/event_<class>_<class_length>" }
        },
        {
            "when": "multi3",
            "set": {
                "class_symbol_3_region": { "x": 544, "y": 1090, "width": 208, "height": 208 },
                "class_symbol_2_region": { "x": 714, "y": 1090, "width": 208, "height": 208 },
                "class_symbol_1_region": { "x": 884, "y": 1090, "width": 208, "height": 208 }
            }
        },
        {   "when": "story",
            "set": {
                "template": "chapter_1/event_neutral",
                "level_overlay": "neutral_no_level.png",
                "encounter_overlay": "story_event_overlay.png",
                "collection_total": "<esn>/<est>",
                "collection_total_region": { "x": 918, "y": 2096, "width": 350, "height": 40 },
                "collection_total_font": { "font": "bold", "size": 38, "color": "white", "alignment": "right" }
            }
        }
    ]
